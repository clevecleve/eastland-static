{
  "name": "eastlands-static",
  "version": "1.0.0",
  "description": "Static snapshot of https://eastland.qicre.com for Netlify deployment",
  "private": true,
  "scripts": {
    "crawl": "CRAWL_ORIGIN=https://eastland.qicre.com CRAWL_OUT_DIR=$(pwd)/dist node ../qicre-static/crawl-generic.js",
    "postprocess": "CRAWL_ORIGIN=https://eastland.qicre.com CRAWL_OUT_DIR=$(pwd)/dist node ../qicre-static/postprocess-generic.js",
    "serve": "npx serve dist -p 3456",
    "build": "npm run crawl && npm run postprocess"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "playwright": "^1.40.0"
  }
}
